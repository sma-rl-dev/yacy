# syntax=docker/dockerfile:1
FROM eclipse-temurin:24-jdk-noble AS builder

RUN apt-get update && apt-get install -y --no-install-recommends ant git && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/yacy_search_server

# Dependency resolution stays cached when only application source changes.
COPY ivy.xml build.xml build.properties ./
RUN --mount=type=cache,target=/root/.ivy2 ant resolve
COPY . .
RUN --mount=type=cache,target=/root/.ivy2 ant compile && \
    sed -i \
      -e 's|^network.unit.definition =.*|network.unit.definition = defaults/yacy.network.intranet.unit|' \
      -e 's|^network.unit.agent =.*|network.unit.agent = TesterEnv|' \
      -e 's|^adminAccountForLocalhost=.*|adminAccountForLocalhost=false|' \
      -e 's|^server.https=.*|server.https=false|' \
      defaults/yacy.init

FROM eclipse-temurin:24-jdk-noble
RUN apt-get update && apt-get install -y --no-install-recommends wkhtmltopdf xvfb ghostscript && rm -rf /var/lib/apt/lists/* && \
    adduser --system --group --no-create-home --disabled-password yacy
WORKDIR /opt
COPY --chown=yacy:yacy --from=builder /opt/yacy_search_server /opt/yacy_search_server
USER yacy
EXPOSE 8090
VOLUME ["/opt/yacy_search_server/DATA"]
CMD ["/bin/sh", "/opt/yacy_search_server/startYACY.sh", "-f"]
